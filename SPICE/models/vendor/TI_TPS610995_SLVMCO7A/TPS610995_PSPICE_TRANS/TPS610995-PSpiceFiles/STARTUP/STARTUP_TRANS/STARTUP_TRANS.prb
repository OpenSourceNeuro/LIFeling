BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE I(L1:IN)
MARKERID 2
END TRACE I(L1:IN)
END YAXIS 1
END ANAPLOT 2
