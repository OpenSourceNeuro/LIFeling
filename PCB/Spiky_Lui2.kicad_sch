	(text "1 - AP rises\n2 - A short Spike_Pulse is created\n3 - Spike pulse opens a brief Peak_Window\n4 - During Peak_Window, an overshoot current is injected into Vm_Int\n5 - In parallel, AP opens the Reset_Window\n6 - When Peak_Window closes and Reset_Window is still open\n	→ V_Reset_Ref is injected into Vm_Int"
		(exclude_from_sim no)
		(at 233.68 391.795 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 132 0 0 1)
			)
